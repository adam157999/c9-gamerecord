		//@@@@@@@@@@@@@@@@@@@@@@@@@@@
		public bool GetGameRecord()
		{
			try
			{
				string startTime = GetJobTime("Start");
				string endTime = GetJobTime("End");

				string method = "open.order.query";
				string webAddr = P_ApiUrl + "/" + method;
				string random = P_GamePrefix + Guid.NewGuid().ToString();
				string sign = digestMD5Key(random);
				string srpc = "2.0";
				int pageSize = 500;

				var httpWebRequest = (HttpWebRequest)WebRequest.Create(webAddr);
				httpWebRequest.ContentType = "application/json";
				httpWebRequest.Method = "POST";
				httpWebRequest.Timeout = 60000;
				httpWebRequest.ReadWriteTimeout = 60000;

				string json = "";
				using (var streamWriter = new StreamWriter(httpWebRequest.GetRequestStream()))
				{
					json = "{ \"id\" : \"" + random +
								"\", \"method\" : \"" + method +
							"\" , \"params\" : { \"random\" : \"" + random + "\" , \"sign\" : \"" + sign + "\" , \"sn\" : \"" + P_sn + "\" , \"startTime\" : \"" + startTime + "\", \"endTime\" : \"" + endTime + "\", \"pageSize\" : \"" + pageSize + "\" }" +
							", \"jsonrpc\" : \"" + srpc + "\"} ";
					//string json = "{ \"id\" : \"" + random +
					//                "\", \"method\" : \"" + method +
					//                "\" , \"params\" : { \"random\" : \"" + random + "\" , \"sign\" : \"" + sign + "\" , \"sn\" : \"" + P_sn + "\" , \"loginIds\" : " + sJSONResponse + ", \"startTime\" : \"" + startTime + "\", \"endTime\" : \"" + endTime + "\", \"pageSize\" : \"" + pageSize + "\" }" +
					//                ", \"jsonrpc\" : \"" + srpc + "\"} ";


					streamWriter.Write(json);
					streamWriter.Flush();
				}

				var httpResponse = (HttpWebResponse)httpWebRequest.GetResponse();
				using (var streamReader = new StreamReader(httpResponse.GetResponseStream()))
				{
					var responseText = streamReader.ReadToEnd();

					GameLogVM result = JsonConvert.DeserializeObject<GameLogVM>(responseText);
					string sMainID = Guid.NewGuid().ToString();

					using (BingoConn db = new BingoConn())
					{
						//Insert Main table
						BGGameMain bGGameMain = new BGGameMain()
						{
							Id = sMainID,
							random = result.id,
							error = result.error,
							total = result.result.total,
							pageIndex = result.result.pageIndex,
							pageSize = result.result.pageSize,
							startTime = Convert.ToDateTime(startTime),
							endTime = Convert.ToDateTime(endTime),
							CreatedDate = DateTime.Now
						};
						db.BGGameMains.Add(bGGameMain);
						db.SaveChanges();

						//Insert Result table
						foreach (var p in result.result.items)
						{
							try
							{
								if (p.loginId.ToUpper().Trim().StartsWith(P_NamePrefix))
								{
									var bggame = db.BGGames.Where(x => x.orderId == p.orderId).FirstOrDefault();
									if (bggame == null)
									{
										var bGGame = new BGGame()
										{
											fId = sMainID,
											orderId = p.orderId,
											sn = p.sn,
											uid = p.uid,
											loginId = p.loginId,
											moduleId = p.moduleId,
											gameId = p.gameId,
											gameName = p.gameName,
											orderStatus = p.orderStatus,
											bAmount = p.bAmount,
											aAmount = p.aAmount,
											orderFrom = p.orderFrom,
											orderTime = p.orderTime,
											lastUpdateTime = p.lastUpdateTime,
											fromIp = p.fromIp,
											issueId = p.issueId,
											playId = p.playId,
											playName = p.playName,
											playNameEn = p.playNameEn,
											validBet = p.validBet,
											payment = p.payment,
											Total = Convert.ToInt32(result.result.total),
											CreatedDate = DateTime.Now,
											betContent = p.betContent,
											noComm = p.noComm
										};
										db.BGGames.AddOrUpdate(bGGame);
									}
								}
							}
							catch (Exception ex)
							{
								_common.LogError("Record " + p.orderId + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
							}
						}

						db.SaveChanges();
					}

					//If record more than 500, need to get the record from Page 2 and above
					decimal dCnt = Convert.ToDecimal(result.result.total) / Convert.ToDecimal(500);
					int iPageIndex = Int32.Parse(Math.Ceiling(dCnt).ToString());

					if (iPageIndex > 1)
					{
						for (int x = 2; x <= iPageIndex; x++)
						{
							bool IsOK = GetGameRecordExtend(x);
						}
					}

					bool isUpdJob = UpdJobTime(startTime, endTime, sMainID);

					return true;

					//json format display
					//string json = JsonConvert.SerializeObject(result);
					//string jsonFormatted = Newtonsoft.Json.Linq.JValue.Parse(json).ToString(Formatting.Indented);
				}
			}
			catch (DbEntityValidationException e)
			{
				foreach (var eve in e.EntityValidationErrors)
				{
					_common.LogError("BG/GetGameRecord" + " " + DateTime.Now.ToString() + " " + string.Format("Entity of type \"{0}\" in state \"{1}\" has the following validation errors:",
							eve.Entry.Entity.GetType().Name, eve.Entry.State), "BG");
					foreach (var ve in eve.ValidationErrors)
					{
						_common.LogError("BG/GetGameRecord" + " " + DateTime.Now.ToString() + " " + string.Format("- Property: \"{0}\", Error: \"{1}\"",
								ve.PropertyName, ve.ErrorMessage), "BG");
					}
				}
				return false;
			}
			catch (Exception ex)
			{
				_common.LogError("BG/GetGameRecord" + " " + DateTime.Now.ToString() + " " + ex.Message.ToString(), "BG");
				return false;
			}
			//return "OK";
		}

		//@@@@@@@@@@@@@@@@@@@@@@@@@@@
		public bool GetGameRecordExtend(int pageIndex)
		{
			string startTime = GetJobTime("Start");
			string endTime = GetJobTime("End");
			string sMainID = Guid.NewGuid().ToString();

			try
			{
				string method = "open.order.query";
				string webAddr = P_ApiUrl + "/" + method;
				string random = P_GamePrefix + Guid.NewGuid().ToString();
				string sign = digestMD5Key(random);
				string srpc = "2.0";
				int pageSize = 500;

				var httpWebRequest = (HttpWebRequest)WebRequest.Create(webAddr);
				httpWebRequest.ContentType = "application/json";
				httpWebRequest.Method = "POST";
				httpWebRequest.Timeout = 60000;
				httpWebRequest.ReadWriteTimeout = 60000;

				using (var streamWriter = new StreamWriter(httpWebRequest.GetRequestStream()))
				{
					string json = "{ \"id\" : \"" + random +
													"\", \"method\" : \"" + method +
													"\" , \"params\" : { \"random\" : \"" + random + "\" , \"sign\" : \"" + sign + "\" , \"sn\" : \"" + P_sn + "\" , \"startTime\" : \"" + startTime + "\", \"endTime\" : \"" + endTime + "\", \"pageSize\" : \"" + pageSize + "\", \"pageIndex\" : \"" + pageIndex + "\" }" +
													", \"jsonrpc\" : \"" + srpc + "\"} ";

					streamWriter.Write(json);
					streamWriter.Flush();
				}
				var httpResponse = (HttpWebResponse)httpWebRequest.GetResponse();
				using (var streamReader = new StreamReader(httpResponse.GetResponseStream()))
				{
					var responseText = streamReader.ReadToEnd();

					GameLogVM result = JsonConvert.DeserializeObject<GameLogVM>(responseText);

					using (BingoConn db = new BingoConn())
					{
						//Insert Main table
						BGGameMain bGGameMain = new BGGameMain()
						{
							Id = sMainID,
							random = result.id,
							error = result.error,
							total = result.result.total,
							pageIndex = result.result.pageIndex,
							pageSize = result.result.pageSize,
							startTime = Convert.ToDateTime(startTime),
							endTime = Convert.ToDateTime(endTime),
							CreatedDate = DateTime.Now
						};
						db.BGGameMains.Add(bGGameMain);
						db.SaveChanges();

						//Insert Result table
						foreach (var p in result.result.items)
						{
							try
							{
								if (p.loginId.ToUpper().Trim().StartsWith(P_NamePrefix))
								{
									var bggame = db.BGGames.Where(x => x.orderId == p.orderId).FirstOrDefault();
									if (bggame == null)
									{
										var bGGame = new BGGame()
										{
											fId = sMainID,
											orderId = p.orderId,
											sn = p.sn,
											uid = p.uid,
											loginId = p.loginId,
											moduleId = p.moduleId,
											gameId = p.gameId,
											gameName = p.gameName,
											orderStatus = p.orderStatus,
											bAmount = p.bAmount,
											aAmount = p.aAmount,
											orderFrom = p.orderFrom,
											orderTime = p.orderTime,
											lastUpdateTime = p.lastUpdateTime,
											fromIp = p.fromIp,
											issueId = p.issueId,
											playId = p.playId,
											playName = p.playName,
											playNameEn = p.playNameEn,
											validBet = p.validBet,
											payment = p.payment,
											CreatedDate = DateTime.Now,
											betContent = p.betContent,
											noComm = p.noComm
										};
										db.BGGames.AddOrUpdate(bGGame);
									}
								}
							}
							catch (Exception ex)
							{
								_common.LogError("Record " + p.orderId + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
							}

						}
						db.SaveChanges();
					}

					return true;
				}
			}
			catch (DbEntityValidationException e)
			{
				foreach (var eve in e.EntityValidationErrors)
				{
					_common.LogError("BG/GetGameRecordExtend" + " " + DateTime.Now.ToString() + "  " + string.Format("Entity of type \"{0}\" in state \"{1}\" has the following validation errors:",
							eve.Entry.Entity.GetType().Name, eve.Entry.State), "BG");
					foreach (var ve in eve.ValidationErrors)
					{
						_common.LogError("BG/GetGameRecordExtend" + " " + DateTime.Now.ToString() + "  " + string.Format("- Property: \"{0}\", Error: \"{1}\"",
								ve.PropertyName, ve.ErrorMessage), "BG");
					}
				}
				return false;
			}
			catch (Exception ex)
			{
				_common.LogError("BG/GetGameRecordExtend" + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
				return false;
			}
		}

		//@@@@@@@@@@@@@@@@@@@@@@@@@@@
		public bool UpdGameRecord(string startTime, string endTime, long orderId)
		{
			try
			{
				string method = "open.order.query";
				string webAddr = P_ApiUrl + "/" + method;
				string random = P_GamePrefix + Guid.NewGuid().ToString();
				string sign = digestMD5Key(random);
				string srpc = "2.0";
				int pageSize = 500;

				var httpWebRequest = (HttpWebRequest)WebRequest.Create(webAddr);
				httpWebRequest.ContentType = "application/json";
				httpWebRequest.Method = "POST";
				httpWebRequest.Timeout = 60000;
				httpWebRequest.ReadWriteTimeout = 60000;

				using (var streamWriter = new StreamWriter(httpWebRequest.GetRequestStream()))
				{
					string json = "{ \"id\" : \"" + random +
													"\", \"method\" : \"" + method +
													"\" , \"params\" : { \"random\" : \"" + random + "\" , \"sign\" : \"" + sign + "\" , \"sn\" : \"" + P_sn + "\", \"startTime\" : \"" + startTime + "\", \"endTime\" : \"" + endTime + "\" , \"pageSize\" : " + pageSize + ", \"orderId\" : " + orderId + " }" +
													", \"jsonrpc\" : \"" + srpc + "\"} ";

					streamWriter.Write(json);
					streamWriter.Flush();
				}

				var httpResponse = (HttpWebResponse)httpWebRequest.GetResponse();
				using (var streamReader = new StreamReader(httpResponse.GetResponseStream()))
				{
					var responseText = streamReader.ReadToEnd();

					GameLogVM result = JsonConvert.DeserializeObject<GameLogVM>(responseText);

					using (BingoConn db = new BingoConn())
					{
						foreach (var p in result.result.items)
						{
							var xyz = db.BGGames.Where(x => x.orderId == p.orderId).FirstOrDefault();
							if (xyz != null)
							{
								xyz.orderStatus = p.orderStatus;
								xyz.bAmount = p.bAmount;
								xyz.aAmount = p.aAmount;
								xyz.orderTime = p.orderTime;
								xyz.lastUpdateTime = p.lastUpdateTime;
								xyz.fromIp = p.fromIp;
								xyz.validBet = p.validBet;
								xyz.payment = p.payment;
								xyz.ModifiedDate = DateTime.Now;

								db.Entry(xyz).State = System.Data.Entity.EntityState.Modified;
								db.SaveChanges();
							}
						}

					}

					return true;
				}
			}
			catch (Exception ex)
			{
				_common.LogError("BG/UpdGameRecord" + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
				return false;
			}
		}

		//@@@@@@@@@@@@@@@@@@@@@@@@@@@
		public bool GetPending()
		{
			try
			{
				using (var bingoConn = new BingoConn())
				{
					var query = bingoConn.BGGames
															.Where(s => s.orderStatus == 1)
															.ToList();

					if (query != null)
					{
						string sID = Guid.NewGuid().ToString();

						BGGameMain bGGameMain = new BGGameMain()
						{
							Id = sID,
							error = "GetPending",
							total = query.Count,
							CreatedDate = DateTime.Now
						};
						bingoConn.BGGameMains.Add(bGGameMain);
						bingoConn.SaveChanges();

						foreach (var x in query)
						{
							DateTime dtSTime = Convert.ToDateTime(x.orderTime);
							string sTime = dtSTime.ToString("yyyy-MM-dd hh:mm:ss");

							bool isUpdOK = UpdGameRecord(sTime, sTime, Convert.ToInt64(x.orderId.ToString()));
						}
					}
				}
				return true;
			}
			catch (Exception ex)
			{
				_common.LogError("BG/GetPending" + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
				return false;
			}
		}

		//@@@@@@@@@@@@@@@@@@@@@@@@@@@
		public bool UpdJobTime(string startTime, string endTime, string fId)
		{
			try
			{
				//DateTime dtStart = Convert.ToDateTime(startTime);
				DateTime dtEnd = Convert.ToDateTime(endTime);

				using (var bingoConn = new BingoConn())
				{
					var xyz = bingoConn.ADMJobDates.Where(s => s.GameProvider == P_GamePrefix).FirstOrDefault();
					if (xyz != null)
					{
						//int iInterval = Convert.ToInt32(xyz.Interval);

						//DateTime dtStartAdd = dtStart.AddMinutes(iInterval);
						//DateTime dtEndAdd = dtEnd.AddMinutes(iInterval);
						//xyz.JobStart = dtStartAdd;
						//xyz.JobEnd = dtEndAdd;

						xyz.LastRunTillDate = dtEnd;

						//bingoConn.Entry(xyz).State = System.Data.Entity.EntityState.Modified;
						bingoConn.SaveChanges();
					}
				}
				return true;
			}
			catch (Exception ex)
			{
				_common.LogError("BG/UpdJobTime" + " " + DateTime.Now.ToString() + "  " + ex.Message.ToString(), "BG");
				return false;
			}
		}

