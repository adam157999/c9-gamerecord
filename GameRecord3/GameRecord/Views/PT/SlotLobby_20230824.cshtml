@{
	/**/

	Layout = null;
}
@model GameRecord.Common.GetPTSlotGameListResponse


<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<title>Games</title>
	<!-- <link rel="stylesheet" href="./style.css"> -->
	<link rel="icon" href="./favicon.ico" type="image/x-icon">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
				integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" href="~/Scripts/LobbyCss.css" />
</head>

<body>
	<div class="container-fluid">
		<div class="row d-flex justify-content-center">
			<!-- <div id="search" class="input-group w-75 mb-3 mt-3">
					<button class="btn btn-outline-secondary" type="button">
							<i class="fa fa-search"></i>
					</button>
					<input type="text" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
			</div> -->
			<div class="inner-addon left-addon w-75 mb-3 mt-3">
				<i class="fa fa-search"></i>
				<input type="text" id="txtGameName" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
			</div>
		</div>

		<hr>
		<div id="games" class="row">
			@if (Model.data != null && Model.data.Count > 0)
			{
				foreach (var row in Model.data)
				{
					<div class="col-4 text-center">
						<img src="@(String.Format(row.GameIcon))" alt="" class="img-thumbnail"
								 onclick="launchGame('@row.GameID')">
						@if (ViewBag.LangId == "en")
						{
							<p class="game-logo" data-gameid="@row.GameID">@row.GameNameEn</p>
						}
						else
						{
							<p class="game-logo" data-gameid="@row.GameID">@row.GameNameCn</p>
						}
					</div>
					@*<button class="c-slot game-logo" data-gameid="@row.gameID"><img src="@(String.Format(Model.imgUrl, row.gameID)+ "?" + DateTime.Now.ToString("yyyyMMddHHmmss"))" /></button>*@
				}
			}
		</div>
		<div id="overlay">
			<div class="cv-spinner">
				<span class="spinner"></span>
			</div>
		</div>
	</div>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
					integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
					crossorigin="anonymous"></script>
	<script src="https://code.jquery.com/jquery-3.6.3.min.js"
					integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU=" crossorigin="anonymous"></script>

	<script>
        var timer;
        $('#txtGameName').keyup(function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var gameName = $.trim($("#txtGameName").val());
                var gameNameLength = $("#txtGameName").val().length;
                if (gameNameLength >= 3 || gameNameLength == 0) {
                    GetGames(gameName)
                }
            }, 500)
        });

        String.format = function () {
            var s = arguments[0];
            for (var i = 0; i < arguments.length - 1; i++) {
                var reg = new RegExp("\\{" + i + "\\}", "gm");
                s = s.replace(reg, arguments[i + 1]);
            }
            return s;
        }

        function GetGames(gameName) {
            var htmlList = "";
            var SetData = $("#games");
            var preSetHtml = "<div id='games' class='row'>"
            var langId = @Html.Raw(Json.Encode(@ViewBag.LangId));
            fadeIn()
            $.ajax({
                type: "POST",
                url: "/PT/SearchGame",
                data: "{gameName:'" + gameName + "',langId:'" + langId + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (games) {
                    if (games != null) {
                        console.log(games.data)
                        for (var index = 0; index < games.data.length; index++) {
                            var fullPath = encodeURI(games.data[index].GameIcon)
                            var fullImgUrl = fullPath;
                            if (langId == "en") {
                                var Data = "<div class='col-4 text-center'>" +
																	"<img src=" + fullImgUrl + " alt=''class='img-thumbnail' onclick=launchGame(" + "'" + games.data[index].GameID + "'" + ")>" +
                                    "<p data-gameid=" + games.data[index].GameID + ">" + games.data[index].GameNameEn + "</p>" +
                                    "</div>";
                                htmlList = Data + htmlList
                            }
                            else {
                                var Data = "<div class='col-4 text-center'>" +
                                    "<img src=" + fullImgUrl + " alt=''class='img-thumbnail' onclick=launchGame(" + "'" + games.data[index].GameID + "'" + ")>" +
																	"<p data-gameid=" + games.data[index].GameID + ">" + games.data[index].GameNameCn + "</p>" +
                                    "</div>";
                                htmlList = Data + htmlList
                            }
                        }
                        SetData.replaceWith(preSetHtml + htmlList)
                    }
                    fadeOut();
                }
            });
        }

        function fadeIn() {
            $("#overlay").fadeIn(300);
        };


        function fadeOut() {
            $("#overlay").fadeOut(300);
        };

        $(document).ready(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');
        });

        $("#filter > button").click(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');

            $(this).removeClass('btn-outline-primary');
            $(this).addClass('btn-primary');
        });

        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        };

        function launchGame(gameId) {
            fadeIn()
            $.ajax({
                type: "GET",
                dataType: "json",
                url: '@Url.Action("LaunchSlot", "PT")',
                data: {
									"playerName": getUrlParameter('playerName'),
									"gameID": gameId,
									"lang": getUrlParameter('lang') == '' ? 'en' : getUrlParameter('lang')
                },
                success: function (res) {
										var data = JSON.parse(res.Data);
										if (data && data.status == 1) {
											//window.location.replace(data.message);
											//window.open(data.message, '_blank', 'fullscreen=yes,scrollbars=yes');
											window.location.href = data.message;
										}
                    fadeOut();
                }
            });
        };
	</script>
</body>

</html>