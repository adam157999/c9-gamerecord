	<script>
		function getUrlParameter(name) {
			name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
			var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
			var results = regex.exec(location.search);
			return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
		};

		$(document).on('click', '.game-icon', function (event) {
			$.ajax({
				type: "GET",
				dataType: "json",
				url: '@Url.Action("LaunchSlot", "PT")',
				data: {
					"playerName": getUrlParameter('playerName'),
					"gameID": $(this).attr('data-gameID'),
					"lang": getUrlParameter('lang') == '' ? 'en' : getUrlParameter('lang')
				},
				success: function (res) {
					var data = JSON.parse(res.Data);
					if (data && data.status == 1) {
						window.location.replace(data.message);
					}
				}
			});
		});

		//$(document).on('click', '.btnBack', function (event) {
		//	var url = window.location.origin + "/PT/Index?playerName=" + getUrlParameter('playerName') + "&lang=" + (getUrlParameter('lang') == '' ? 'en' : getUrlParameter('lang'));
		//	window.location.replace(url);
		//});

		$(document).on('click', '.btn-all', function (event) {
			$('.game-icon').removeClass('hide-game');
		});

		$(document).on('click', '.btn-hot', function (event) {
			$('.game-icon').removeClass('hide-game');
		});

		$(document).on('click', '.btn-jackpot', function (event) {
			$('.game-icon').addClass('hide-game');
			$('.jackpot-game').removeClass('hide-game');
		});
	</script>
