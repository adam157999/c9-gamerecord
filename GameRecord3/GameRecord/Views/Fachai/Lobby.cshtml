    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js" integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU=" crossorigin="anonymous"></script>
    <script>
    var overlay; // Declare globally
    var timer;
    var providerModal = null;
    var providerCache = [];
    var selectedProviderId = localStorage.getItem('selected_provider_id') || '';
    var selectedProviderImg = localStorage.getItem('selected_provider_img') || '';
    var DEFAULT_C5_API_BASE = '@(ConfigurationManager.AppSettings["C5ApiBaseUrl"] ?? "https://a1bo-qa.azurewebsites.net")';

    document.addEventListener("DOMContentLoaded", function () {
        overlay = document.getElementById("overlay"); // Assign after DOM loads
    });

    function showOverlay() {
        if (overlay) overlay.style.display = "flex";
    }

    function hideOverlay() {
        if (overlay) overlay.style.display = "none";
    }

    function filterGames(gameName) {
        var keyword = (gameName || '').toLowerCase();

        $('#games ._game').each(function () {
            var name = (($(this).attr('data-name') || '') + ' ' + ($(this).find('p').text() || '')).toLowerCase();
            var matched = !keyword || name.indexOf(keyword) >= 0;
            $(this).toggle(matched);
        });
    }

    function GetGames(gameName, gameCategory) {
        filterGames(gameName);
    }

    $('#txtGameName').keyup(function () {
        clearTimeout(timer);
        timer = setTimeout(function () {
            var gameName = $.trim($("#txtGameName").val());
            var gameNameLength = gameName.length;
            if (gameNameLength >= 3 || gameNameLength == 0) {
                GetGames(gameName, null);
            }
        }, 500);
    });

    $('.jCat').click(function () {
        $("#txtGameName").val("");
        GetGames("", $(this).attr('id'));
    });

    $(document).ready(function () {
        $('#filter > button')
            .removeClass('btn-primary active-cat')
            .addClass('btn-outline-primary');

        $('#All')
            .removeClass('btn-outline-primary')
            .addClass('btn-primary active-cat');
    });

    $("#filter > button").click(function () {
        $('#filter > button')
            .removeClass('btn-primary active-cat')
            .addClass('btn-outline-primary');

        $(this)
            .removeClass('btn-outline-primary')
            .addClass('btn-primary active-cat');
    });

function launchGame(gameCode) {

    var playerid = "@(ViewBag.playerid)";
    var currency = "@(ViewBag.currency)";
    var ip = "@(ViewBag.ip)";
    var language = "@(ViewBag.lang)";
    var mobile = "@(ViewBag.mobile)";


    showOverlay();

    $.ajax({
        url: "@Url.Action("LaunchGame", "Fachai")",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({
            gameCode: gameCode,
            playerid: playerid,
            currency: currency,
            ip: ip,
            mobile: mobile,
            Language: language
        }),
        success: function(response) {

            hideOverlay();

            if (response.success) {
                // Redirect to game URL
                window.location.href = response.url;
            } else {
                alert(response.message);
            }
        },
        error: function(xhr, status, error) {
            hideOverlay();
            alert("Error launching game: " + error);
        }
    });
}

// Attach click event to game images
$(document).ready(function() {
    $(".img-thumbnail").on("click", function() {
        var gameCode = $(this).next("p").attr("data-gameid");
        launchGame(gameCode);
    });
});

    (function persistToken() {
        try {
            var token = '';

            var hash = (window.location.hash || '').replace(/^#/, '');
            if (hash) {
                var hashParams = new URLSearchParams(hash);
                token =
                    (hashParams.get('t') || '').trim() ||
                    (hashParams.get('token') || '').trim();
            }

            if (!token) {
                var urlObj = new URL(window.location.href);
                token =
                    (urlObj.searchParams.get('t') || '').trim() ||
                    (urlObj.searchParams.get('token') || '').trim();
            }

            if (token) {
                localStorage.setItem('token', token);
                localStorage.setItem('access_token', token);
            }

            var cleanUrl = window.location.href.split('#')[0];
            try {
                var u = new URL(cleanUrl);
                u.searchParams.delete('t');
                u.searchParams.delete('token');
                cleanUrl = u.toString();
            } catch (e) { }

            history.replaceState(null, '', cleanUrl);
        } catch (e) { }
    })();

    function requestTokenFromParent() {
        try {
            if (window.parent && window.parent !== window) {
                window.parent.postMessage({ type: 'REQ_TOKEN' }, '*');
            }
        } catch (e) { }
    }

    window.addEventListener('message', function (e) {
        try {
            var d = e.data || {};
            if (d.type === 'RES_TOKEN' && d.token) {
                localStorage.setItem('token', (d.token || '').trim());
                localStorage.setItem('access_token', (d.token || '').trim());
            }
        } catch (ex) { }
    });

    function escapeHtml(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getQueryParam(name) {
        try {
            var url = new URL(window.location.href);
            return url.searchParams.get(name) || '';
        } catch (e) {
            return '';
        }
    }

    function getC5ApiBase() {
        var b = (getQueryParam('api') || '').trim();
        if (b) return b.replace(/\/+$/, '');
        return DEFAULT_C5_API_BASE.replace(/\/+$/, '');
    }

    function getBearerToken() {
        var keys = ['token', 'access_token', 'Token', 'AccessToken'];
        for (var i = 0; i < keys.length; i++) {
            var v = localStorage.getItem(keys[i]);
            if (v && v.trim()) return v.trim();
        }
        return '';
    }

    function getLangHeader() {
        var lang = "@(ViewBag.lang)";
        return ((lang || '').toLowerCase() === 'en') ? 'en' : 'zh-CN';
    }

    function normName(s) {
        return (s || '').toString().replace(/\s+/g, '').toUpperCase();
    }

    function setProviderBtnImg(imgUrl) {
        var $img = $('#providerBtnImg');
    $('#providerBtnImg').attr('src', imgUrl).show();
    $('#topLogoImg').attr('src', imgUrl).show();
        if (imgUrl) {
            $img.attr('src', imgUrl).show();
        } else {
            $img.attr('src', '').hide();
        }
    }

    function c5Ajax(opts) {
        var token = getBearerToken();
        if (!token) {
            requestTokenFromParent();
            if (opts && typeof opts.error === 'function') {
                opts.error({ status: 401, message: 'Missing token (localStorage). Please login again.' });
            }
            return;
        }

        return $.ajax($.extend(true, {
            headers: {
                'Authorization': 'bearer ' + token,
                'Lang': getLangHeader()
            },
            timeout: 60000
        }, opts)).fail(function (xhr) {
            if (xhr && (xhr.status === 401 || xhr.status === 403)) {
                console.warn('C5 auth failed. token exists but server rejected it.');
            }
        });
    }

    function isSlotProvider(x) {
        var cat = ((x.GameCategory || '') + '').toLowerCase();
        return cat.indexOf('slot') >= 0;
    }

    function hasLobbyImage(x) {
        return !!((x.ImageLobby || '').trim());
    }

    $(document).ready(function () {
        setProviderBtnImg(selectedProviderImg || '');

        if (!getBearerToken()) {
            requestTokenFromParent();
            setTimeout(function () {
                preloadProvidersForButton();
            }, 300);
        } else {
            preloadProvidersForButton();
        }
    });

    function preloadProvidersForButton() {
        if (providerCache && providerCache.length > 0) {
            if (!selectedProviderImg && providerCache.length > 0) {
                selectedProviderId = providerCache[0].Id || '';
                selectedProviderImg = providerCache[0].ImageLobby || '';
                localStorage.setItem('selected_provider_id', selectedProviderId);
                localStorage.setItem('selected_provider_img', selectedProviderImg);
            }
            setProviderBtnImg(selectedProviderImg || '');
            return;
        }

        c5Ajax({
            url: getC5ApiBase() + '/api/MapiDiscover/Discover',
            type: 'GET',
            data: { Platform: 'Web' },
            success: function (resp) {
                var games = (resp && resp.Games) ? resp.Games : [];

                providerCache = (games || []).filter(function (x) {
                    return isSlotProvider(x) && hasLobbyImage(x);
                });

                if (selectedProviderId) {
                    var picked = providerCache.find(function (x) { return (x.Id || '') === selectedProviderId; });
                    if (picked) {
                        selectedProviderImg = picked.ImageLobby || '';
                        localStorage.setItem('selected_provider_img', selectedProviderImg);
                    }
                }

                if (!selectedProviderId && providerCache.length > 0) {
                    selectedProviderId = providerCache[0].Id || '';
                    selectedProviderImg = providerCache[0].ImageLobby || '';
                    localStorage.setItem('selected_provider_id', selectedProviderId);
                    localStorage.setItem('selected_provider_img', selectedProviderImg);
                }

                setProviderBtnImg(selectedProviderImg || '');
            }
        });
    }

    $('#btnProvider').on('click', function () {
        if (!providerModal) providerModal = new bootstrap.Modal(document.getElementById('providerModal'));
        providerModal.show();
        loadProviders();
    });

    function loadProviders() {
        var token = getBearerToken();
        if (!token) {
            $('#providerGrid').html('<div class="text-danger">Missing token (localStorage). Please login again.</div>');
            return;
        }

        if (providerCache && providerCache.length > 0) {
            renderProviderGrid(providerCache);
            return;
        }

        showOverlay();

        c5Ajax({
            url: getC5ApiBase() + '/api/MapiDiscover/Discover',
            type: 'GET',
            data: { Platform: 'Web' },
            success: function (resp) {
                var games = (resp && resp.Games) ? resp.Games : [];

                providerCache = (games || []).filter(function (x) {
                    return isSlotProvider(x) && hasLobbyImage(x);
                });

                renderProviderGrid(providerCache);
            },
            error: function (xhr) {
                $('#providerGrid').html('<div class="text-danger">Failed to load providers: ' + (xhr && xhr.status ? xhr.status : '') + '</div>');
            },
            complete: function () {
                hideOverlay();
            }
        });
    }

    function renderProviderGrid(list) {
        if (!list || list.length === 0) {
            $('#providerGrid').html('<div class="text-muted">No providers.</div>');
            return;
        }

var hiddenProviders = [
    'AFB',
    'ADVANTPLAY',
    'PLAYSTAR',
    'GFG',
    'LUCKY365',
    'AWC',
    'VPLUS'
];

var html = '';

list
    .filter(function (g) {
        var name = (g.Name || '')
    .toUpperCase()
    .replace(/\s+/g, '')
    .trim();
        return hiddenProviders.indexOf(name) === -1;
    })
    .forEach(function (g) {
            var id = g.Id || '';
            var name = g.Name || '';
            var img = g.ImageLobby || '';
            var activeClass = (selectedProviderId && id === selectedProviderId) ? ' active' : '';

            if (!img) return;

            html += '<div class="provider-item' + activeClass + '" data-id="' + escapeHtml(id) + '" data-name="' + escapeHtml(name) + '" data-img="' + escapeHtml(img) + '">';
            html += '  <div class="provider-thumb">';
            html += '      <img src="' + escapeHtml(img) + '" alt="" onerror="this.onerror=null;this.style.display=\'none\';">';
            html += '  </div>';
            html += '</div>';
        });

        $('#providerGrid').html(html);

        $('#providerGrid .provider-item').off('click').on('click', function () {
            var id = $(this).data('id');
            var img = $(this).data('img');

            selectedProviderId = id || '';
            selectedProviderImg = img || '';

            localStorage.setItem('selected_provider_id', selectedProviderId);
            localStorage.setItem('selected_provider_img', selectedProviderImg);

            setProviderBtnImg(selectedProviderImg);

            if (providerModal) providerModal.hide();

            quitThenLaunch(selectedProviderId);
        });
    }

    function quitThenLaunch(gameId) {
        if (!gameId) {
            alert('Invalid provider Id');
            return;
        }

        showOverlay();

        c5Ajax({
            url: getC5ApiBase() + '/api/MapiDiscover/QuitGame',
            type: 'GET',
            data: { Platform: 'Web' },
            timeout: 120000,
            success: function (qres) {
                if (qres && (qres.Code === 0 || qres.Code === 1)) {
                    launchProvider(gameId);
                } else {
                    hideOverlay();
                    alert((qres && qres.Message) ? qres.Message : 'QuitGame failed.');
                }
            },
            error: function (xhr) {
                hideOverlay();
                alert('QuitGame failed: ' + (xhr && xhr.status ? xhr.status : ''));
            }
        });
    }

function launchProvider(gameId, imgUrl) {

    var oldBtnLogo = $('#providerBtnImg').attr('src');
    var oldTopLogo = $('#topLogoImg').attr('src');

    c5Ajax({
        url: getC5ApiBase() + '/api/MapiDiscover/LaunchGame',
        type: 'GET',
        data: {
            Id: gameId,
            Platform: 'Web'
        },
        timeout: 120000,

        success: function (res) {

            if (res && res.Code === 0 && res.Url) {

                // ONLY update logo after successful launch
                setProviderBtnImg(imgUrl);

                window.location.href = res.Url;

            } else {

                hideOverlay();

                // restore previous logo
                $('#providerBtnImg').attr('src', oldBtnLogo);
                $('#topLogoImg').attr('src', oldTopLogo);

                alert(
                    (res && res.Message)
                        ? res.Message
                        : 'Failed to switch provider.'
                );
            }
        },

        error: function (xhr) {

            hideOverlay();

            // restore previous logo
            $('#providerBtnImg').attr('src', oldBtnLogo);
            $('#topLogoImg').attr('src', oldTopLogo);

            alert(
                'LaunchGame failed: ' +
                (xhr && xhr.status ? xhr.status : '')
            );
        }
    });
}
    </script>
</body>
</html>