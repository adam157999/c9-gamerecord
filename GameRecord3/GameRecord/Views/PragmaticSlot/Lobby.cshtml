<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Games</title>
    <!-- <link rel="stylesheet" href="./style.css"> -->
    <link rel="icon" href="./favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Scripts/LobbyCss.css" />
       <style>
        .container-fluid {
            padding-left: 18px;
            padding-right: 18px;
        }

        .inner-addon {
            position: relative;
        }

            .inner-addon.left-addon > i.fa-search,
            .inner-addon.left-addon > i.fa.fa-search {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                pointer-events: none;
                z-index: 2;
            }

            .inner-addon.left-addon > input.form-control {
                padding-left: 42px !important;
            }

        .lobby-top-row {
            margin-left: 0;
            margin-right: 0;
        }

            .lobby-top-row > .col-6:first-child {
                padding-left: 0;
                padding-right: 6px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 6px;
                padding-right: 0;
            }

#txtGameName {
    height: 44px;
    border-radius: 10px;

    padding-top: 0;
    padding-bottom: 0;

    line-height: 44px;
}

#txtGameName::placeholder {
    line-height: normal;
}

        .provider-btn {
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #fff;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 0 10px;
            overflow: hidden;
        }

            .provider-btn .provider-btn-img-wrap {
                flex: 1;
                height: 100%;
                min-width: 0;
                display: flex !important;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

.provider-btn .provider-img {
    width: auto;
    height: auto;
    max-width: 70%;
    max-height: 70%;
    object-fit: contain;
    border-radius: 0;
    border: 0;
    background: transparent;
    display: block;
}

            .provider-btn i {
                flex: 0 0 auto;
            }

        /* ===== category tabs：只有 selected 是绿色，其他黑色 ===== */
#filter {
    width: 100%;

    margin: 0;
    margin-top: -1px;

    border: 0;

    background: #fff;

    overflow: hidden;

    padding: 0;
}

#filter.btns {
    display: flex !important;

    justify-content: space-evenly;
    align-items: center;

    border-bottom: 1px solid #e5e5e5;
}

#filter .custom {
    width: 72px;

    margin: 0;

    height: 42px;

    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    background: transparent !important;

    color: #222 !important;

    font-size: 14px;
    font-weight: 600;

    position: relative;

    padding-left: 0 !important;
    padding-right: 0 !important;
}

                #filter .custom.btn-primary,
                #filter .custom.active-cat {
                    background: transparent !important;
                    color: #6fc9bf !important;
                }

                    #filter .custom.btn-primary::after,
                    #filter .custom.active-cat::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: -1px;
                        height: 2px;
                        background: #6fc9bf;
                    }

        .hr1 {
            margin-top: 0;
            margin-bottom: 10px;
        }

        #games {
            padding-left: 18px;
            padding-right: 18px;
        }

            #games.row {
                margin-left: 0;
                margin-right: 0;
            }

        .provider-modal-dialog {
            width: calc(100% - 28px);
            max-width: 380px;
            margin-left: auto;
            margin-right: auto;
            margin-top: 118px;
            margin-bottom: 16px;
        }

        .modal-dialog-centered.provider-modal-dialog {
            min-height: unset;
            display: block;
            align-items: unset;
        }

        .provider-modal-content {
            border-radius: 8px;
            overflow: hidden;
            border: 0;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
        }

            .provider-modal-content .modal-header {
                height: 48px;
                padding: 0 14px !important;
                border-bottom: 1px solid #e3e3e3;
            }

            .provider-modal-content .modal-title {
                font-size: 13px;
                font-weight: 700;
                line-height: 1;
            }

            .provider-modal-content .btn-close {
                width: 14px;
                height: 14px;
                padding: 0;
                box-shadow: none;
            }

        .provider-modal-body {
            max-height: 412px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 12px 12px 12px !important;
        }

            .provider-modal-body::-webkit-scrollbar {
                width: 4px;
            }

            .provider-modal-body::-webkit-scrollbar-track {
                background: transparent;
            }

            .provider-modal-body::-webkit-scrollbar-thumb {
                background: rgba(0, 0, 0, .35);
                border-radius: 10px;
            }

        .provider-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        @@media (min-width: 768px) {
            .provider-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }
        }

        .provider-item {
            cursor: pointer;
            user-select: none;
            width: 100%;
        }

        .provider-thumb {
            width: 100%;
            height: 60px;
            border-radius: 8px;
            border: 1px solid #e6e6e6;
            background: #fff;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px 6px;
        }

            .provider-thumb img {
                max-width: 100%;
                max-height: 100%;
                width: auto;
                height: auto;
                object-fit: contain;
                display: block;
            }

        .provider-item.active .provider-thumb {
            outline: 2px solid #7ad9cf;
            background: #ecfcfa;
        }

        @@media (max-width: 575.98px) {
            .container-fluid {
                padding-left: 16px;
                padding-right: 16px;
            }

            #games {
                padding-left: 16px;
                padding-right: 16px;
            }

            .lobby-top-row > .col-6:first-child {
                padding-right: 5px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 5px;
            }

            .provider-modal-dialog {
                width: calc(100% - 24px);
                max-width: 372px;
                margin-top: 112px;
            }

            .provider-modal-body {
                max-height: 404px;
                padding: 10px 10px 12px 10px !important;
            }

            .provider-grid {
                gap: 8px;
            }

            .provider-thumb {
                height: 60px;
            }
        }

        @@media (max-width: 390px) {
            .container-fluid {
                padding-left: 14px;
                padding-right: 14px;
            }

            #games {
                padding-left: 14px;
                padding-right: 14px;
            }

            .provider-modal-dialog {
                width: calc(100% - 20px);
                margin-top: 108px;
            }

            .provider-modal-body {
                max-height: 396px;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .provider-thumb {
                height: 50px;
            }
        }
        @@media (max-width: 420px) {

    #txtGameName {
        font-size: 13px;
    }

    #txtGameName::placeholder {
        font-size: 13px;
    }

.inner-addon.left-addon > input.form-control {
    padding-left: 50px !important;
}

    .inner-addon.left-addon > i.fa-search,
    .inner-addon.left-addon > i.fa.fa-search {
        left: 12px;
    }

    #filter .custom {
        width: 64px;
        font-size: 11px;
        letter-spacing: -0.2px;
    }
}
.game-section-box {
    border: 1px solid #e5e5e5;
    border-radius: 18px;

    background: #fff;

    margin-top: 12px;

    overflow: hidden;

    padding-bottom: 16px;
}
#overlay {
    position: fixed;

    top: 0;
    left: 0;

    width: 100vw;
    height: 100vh;

    background: rgba(0,0,0,0.45);

    z-index: 9999;

    display: none;

    justify-content: center;
    align-items: center;
}

    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row d-flex justify-content-center">
                    <div class="row">
<div class="col-12 text-center mt-3 mb-2">
    <span class="top-logo-img">
        <img id="topLogoImg"
             class="provider-img"
             src=""
             alt=""
             style="display:none;">
    </span>
</div>
        </div>
            <!-- <div id="search" class="input-group w-75 mb-3 mt-3">
                <button class="btn btn-outline-secondary" type="button">
                    <i class="fa fa-search"></i>
                </button>
                <input type="text" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
            </div> -->
        <div class="row d-flex justify-content-center lobby-top-row">
            <div class="col-6">
                <div class="inner-addon left-addon mb-3 mt-3">
                    <i class="fa fa-search"></i>
                    <input type="text" id="txtGameName" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
                </div>
            </div>

            <div class="col-6">
                <button type="button" class="provider-btn w-100 mb-3 mt-3" id="btnProvider" aria-label="select-provider">
                    <span class="provider-btn-img-wrap">
                        <img id="providerBtnImg" class="provider-img" src="" alt="" style="display:none;">
                    </span>
                    <i class="fa fa-angle-right"></i>
                </button>
            </div>
        </div>
        </div>
        <div class="game-section-box">
        <div class="row d-flex justify-content-center">
            <div id="filter" class="mb-3 d-flex justify-content-center">
                <button class="btn btn-outline-primary custom" type="button" id="All">All</button>
                <button class="btn btn-outline-primary custom" type="button" id="Hot">Hot</button>
                <button class="btn btn-outline-primary custom" type="button" id="New">New</button>
                <button class="btn btn-outline-primary custom" type="button" id="Favourite">Favourite</button>
            </div>
            <div id="filter" class="mb-3 d-flex justify-content-center">

            </div>

        </div>
        

        <div id="games" class="row">
            @if (Model.gameList != null && Model.gameList.Count > 0)
            {
                foreach (var row in Model.gameList)
                {
                    <div class="col-4 text-center">
                        <img src="@(String.Format(Model.imgUrl, row.gameID)+ "?" + DateTime.Now.ToString("yyyyMMddHHmmss"))" alt="" class="img-thumbnail"
                             onclick="launchGame('@row.gameID')">
                        <p data-gameid="@row.gameID">@row.gameName</p>
                    </div>
                }

            }
        </div>
        </div>
                <div id="overlay">
            <div class="cv-spinner">
                <span class="spinner"></span>
            </div>
        </div>
        <hr>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js"
            integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU=" crossorigin="anonymous"></script>

    <script>
        var timer;
        var gameCategory ="";
        $('#txtGameName').keyup(function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var gameName = $.trim($("#txtGameName").val());
                var gameNameLength = $("#txtGameName").val().length;
                if (gameNameLength >= 3 || gameNameLength == 0) {
                    GetGames(gameName, gameCategory)
                }
            }, 500)
        });

        $('#All').click(function () {
            gameCategory = $('#All').attr('id')
            $("#txtGameName").val("")
            GetGames("", $('#All').attr('id'))
        });
        $('#Hot').click(function () {
            gameCategory = $('#Hot').attr('id')
            $("#txtGameName").val("")
            GetGames("", $('#Hot').attr('id'))

        });
        $('#New').click(function () {
            gameCategory = $('#New').attr('id')
            $("#txtGameName").val("")
            GetGames("", $('#New').attr('id'))
        });
        $('#Favourite').click(function () {
            gameCategory = $('#Favourite').attr('id')
            $("#txtGameName").val("")
            GetGames("", $('#Favourite').attr('id'))

        });

        String.format = function () {
            var s = arguments[0];
            for (var i = 0; i < arguments.length - 1; i++) {
                var reg = new RegExp("\\{" + i + "\\}", "gm");
                s = s.replace(reg, arguments[i + 1]);
            }
            return s;
        }

        function GetGames(gameName, gameCategory) {
            var htmlList = "";
            var SetData = $("#games");
            var preSetHtml = "<div id='games' class='row'>"
            fadeIn();
            $.ajax({
                type: "POST",
                url: "/PragmaticSlot/SearchGame",
                data: "{gameName:'" + gameName + "',gameCategory:'" + gameCategory + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (games) {
                    if (games.gameList != null) {
                        for (var index = 0; index < games.gameList.length; index++) {
                            var imgUrl = games.imgUrl
                            var fullPath = String.format(games.imgUrl, games.gameList[index].gameID)
                            var fullImgUrl = fullPath + "?" + @DateTime.Now.ToString("yyyyMMddHHmmss");
                            var Data = "<div class='col-4 text-center'>" +
                                "<img src=" + fullImgUrl + " alt=''class='img-thumbnail' onclick=launchGame("+"'"+games.gameList[index].gameID+"'"+")>" +
                                "<p data-gameid=" + games.gameList[index].gameID + ">" + games.gameList[index].gameName + "</p>" +
                                "</div>";
                            htmlList = Data + htmlList
                        }
                        SetData.replaceWith(preSetHtml + htmlList)
                    }

                    fadeOut();
                }
            });
        }

        function fadeIn(){
            $("#overlay").fadeIn(300);
        };


        function fadeOut() {
            $("#overlay").fadeOut(300);
        };

        $(document).ready(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');
        });

        $("#filter > button").click(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');

            $(this).removeClass('btn-outline-primary');
            $(this).addClass('btn-primary');
        });

         function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        };

        function launchGame(gameId) {
            fadeIn();
            $.ajax({
                type: "GET",
                dataType: "json",
                url: '@Url.Action("LaunchDirectGame", "PragmaticSlot")',
                data: {
                    "username": getUrlParameter('username'),
                    "gameid": gameId,
                    "langid": getUrlParameter('langid'),
                },
                success: function (res) {
                    var data = JSON.parse(res.Data);
                    if (data && data.ErrorCode == 0) {
                        //var userAgent = navigator.userAgent || navigator.vendor || window.opera;
                        //// iOS detection from: http://stackoverflow.com/a/9039885/177710
                        //if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
                        //    setTimeout(() => {
                        //        window.open(data.Url, "_blank");
                        //    }, 500);
                        //}
                        //else {
                        //    console.log("I am android")
                        //    window.location.href = data.url;
                        //}
                        setTimeout(() => {
                            window.open(data.url, "_blank");
                        }, 500);
                    }

                    fadeOut();
                }
            });
        }
    </script>
</body>

</html>