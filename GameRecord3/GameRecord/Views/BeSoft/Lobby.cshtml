@model GameRecord.Models.BeSoftPlayLobbyVM
@using System.Configuration
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Games</title>
    <link rel="icon" href="./favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Scripts/LobbyCss.css" />

    <style>

        .container-fluid {
            padding-left: 18px;
            padding-right: 18px;
        }

        .inner-addon {
            position: relative;
        }

            .inner-addon.left-addon > i.fa-search,
            .inner-addon.left-addon > i.fa.fa-search {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                pointer-events: none;
                z-index: 2;
            }

.inner-addon.left-addon > input.form-control {
    padding-left: 60px !important;
}

        .lobby-top-row {
            margin-left: 0;
            margin-right: 0;
        }

            .lobby-top-row > .col-6:first-child {
                padding-left: 0;
                padding-right: 6px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 6px;
                padding-right: 0;
            }

#txtGameName {
    height: 44px;
    border-radius: 10px;

    padding-top: 0;
    padding-bottom: 0;

    line-height: 44px;
}
#txtGameName::placeholder {
    line-height: normal;
}
        .provider-btn {
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #fff;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 0 10px;
            overflow: hidden;
        }

            .provider-btn .provider-btn-img-wrap {
                flex: 1;
                height: 100%;
                min-width: 0;
                display: flex !important;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

.provider-btn .provider-img {
    width: auto;
    height: auto;
    max-width: 70%;
    max-height: 70%;
    object-fit: contain;
    border-radius: 0;
    border: 0;
    background: transparent;
    display: block;
}

            .provider-btn i {
                flex: 0 0 auto;
            }

        /* ===== category tabs：只有 selected 是绿色，其他黑色 ===== */
#filter {
    width: calc(100% - 22px);

    margin: 0px ;
    margin-top: -1px;
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    background: #fff;

    overflow: hidden;

    padding: 0;
}

            #filter.btns {
                display: grid !important;
                grid-template-columns: repeat(4, 1fr);
                justify-content: unset !important;
                align-items: end;
            }

#filter .custom {
    margin: 0;

    height: 42px;

    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    background: transparent !important;

    color: #222 !important;

    font-size: 14px;
    font-weight: 600;

    position: relative;
}

                #filter .custom.btn-primary,
                #filter .custom.active-cat {
                    background: transparent !important;
                    color: #6fc9bf !important;
                }

                    #filter .custom.btn-primary::after,
                    #filter .custom.active-cat::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: -1px;
                        height: 2px;
                        background: #6fc9bf;
                    }

        .hr1 {
            margin-top: 0;
            margin-bottom: 10px;
        }

        /* ===== games 区域左右 padding 也跟上面一致 ===== */
        #games {
            padding-left: 18px;
            padding-right: 18px;
        }

            #games.row {
                margin-left: 0;
                margin-right: 0;
            }

        /* ===== modal 整体更贴近参考图 ===== */
        .provider-modal-dialog {
            width: calc(100% - 28px);
            max-width: 380px;
            margin-left: auto;
            margin-right: auto;
            margin-top: 118px;
            margin-bottom: 16px;
        }

        .modal-dialog-centered.provider-modal-dialog {
            min-height: unset;
            display: block;
            align-items: unset;
        }

        .provider-modal-content {
            border-radius: 8px;
            overflow: hidden;
            border: 0;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
        }

            .provider-modal-content .modal-header {
                height: 48px;
                padding: 0 14px !important;
                border-bottom: 1px solid #e3e3e3;
            }

            .provider-modal-content .modal-title {
                font-size: 13px;
                font-weight: 700;
                line-height: 1;
            }

            .provider-modal-content .btn-close {
                width: 14px;
                height: 14px;
                padding: 0;
                box-shadow: none;
            }

        .provider-modal-body {
            max-height: 412px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 12px 12px 12px !important;
        }

            .provider-modal-body::-webkit-scrollbar {
                width: 4px;
            }

            .provider-modal-body::-webkit-scrollbar-track {
                background: transparent;
            }

            .provider-modal-body::-webkit-scrollbar-thumb {
                background: rgba(0, 0, 0, .35);
                border-radius: 10px;
            }

        /* ===== provider 格子跟参考图更接近 ===== */
        .provider-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        @@media (min-width: 768px) {
            .provider-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }
        }

        .provider-item {
            cursor: pointer;
            user-select: none;
            width: 100%;
        }

        .provider-thumb {
            width: 100%;
            height: 60px;
            border-radius: 8px;
            border: 1px solid #e6e6e6;
            background: #fff;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px 6px;
        }

            .provider-thumb img {
                max-width: 100%;
                max-height: 100%;
                width: auto;
                height: auto;
                object-fit: contain;
                display: block;
            }

        .provider-item.active .provider-thumb {
            outline: 2px solid #7ad9cf;
            background: #ecfcfa;
        }

        /* ===== mobile 再微调 ===== */
        @@media (max-width: 575.98px) {
            .container-fluid {
                padding-left: 16px;
                padding-right: 16px;
            }

            #games {
                padding-left: 16px;
                padding-right: 16px;
            }

            .lobby-top-row > .col-6:first-child {
                padding-right: 5px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 5px;
            }

            .provider-modal-dialog {
                width: calc(100% - 24px);
                max-width: 372px;
                margin-top: 112px;
            }

            .provider-modal-body {
                max-height: 404px;
                padding: 10px 10px 12px 10px !important;
            }

            .provider-grid {
                gap: 8px;
            }

            .provider-thumb {
                height: 60px;
            }
        }

        @@media (max-width: 390px) {
            .container-fluid {
                padding-left: 14px;
                padding-right: 14px;
            }

            #games {
                padding-left: 14px;
                padding-right: 14px;
            }

            .provider-modal-dialog {
                width: calc(100% - 20px);
                margin-top: 108px;
            }

            .provider-modal-body {
                max-height: 396px;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .provider-thumb {
                height: 50px;
            }
        }

        .game-section-box {
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    background: #fff;
    margin-top: 12px;
    padding-bottom: 16px;
}
#overlay {
    position: fixed;

    top: 0;
    left: 0;

    width: 100vw;
    height: 100vh;

    background: rgba(0,0,0,0.45);

    z-index: 9999;

    display: none;

    justify-content: center;
    align-items: center;
}
@@media (max-width: 420px) {

    #txtGameName {
        font-size: 13px;
    }

    #txtGameName::placeholder {
        font-size: 13px;
    }

    /* reduce gap between search icon and placeholder */
    .inner-addon.left-addon > input.form-control {
        padding-left: 45px !important;
    }

    .inner-addon.left-addon > i.fa-search,
    .inner-addon.left-addon > i.fa.fa-search {
        left: 12px;
    }

    /* smaller gap between tab buttons */
#filter.btns {
    display: flex !important;
    justify-content: space-evenly;
    align-items: center;
}

#filter .custom {
    font-size: 11px;

    padding-left: 0 !important;
    padding-right: 0 !important;

    letter-spacing: -0.2px;
}

}
  </style>
</head>

<body class="relax">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 text-center mt-3 mb-2">
<span class="top-logo-img">
    <img id="topLogoImg" class="provider-img" src="" alt="" style="display:none;">
</span>
            </div>
        </div>

        <div class="row d-flex justify-content-center lobby-top-row">
            <div class="col-6">
                <div class="inner-addon left-addon mb-3 mt-3">
                    <i class="fa fa-search"></i>
                    <input type="text" id="txtGameName" class="form-control" placeholder="Search Game" aria-label="search-game-name">
                </div>
            </div>

            <div class="col-6">
                <button type="button" class="provider-btn w-100 mb-3 mt-3" id="btnProvider" aria-label="select-provider">
                    <span class="provider-btn-img-wrap">
                        <img id="providerBtnImg" class="provider-img" src="" alt="" style="display:none;">
                    </span>
                    <i class="fa fa-angle-right"></i>
                </button>
            </div>
        </div>
<div class="game-section-box">

    <div class="row d-flex justify-content-center">
        <div id="filter" class="d-flex justify-content-center btns">
            <button class="btn-outline-primary custom jCat" type="button" id="All">All</button>
            <button class="btn-outline-primary custom jCat" type="button" id="Hot">Hot</button>
            <button class="btn-outline-primary custom jCat" type="button" id="New">New</button>
            <button class="btn-outline-primary custom jCat" type="button" id="Favourite">Bonus Buy</button>
        </div>
    </div>

    <div id="games" class="row">
        @foreach (var g in Model.games)
        {
            <div class="_game text-center">
                @if (Model.lang == "en")
                {
                    <img src="@g.GameIcon" alt="" class="img-thumbnail" onclick="launchGame('@g.Gid')" />
                    <p data-gameid="@g.Gid">@g.Name</p>
                }
                else
                {
                    <img src="@g.GameIconCn" alt="" class="img-thumbnail" onclick="launchGame('@g.Gid')" />
                    <p data-gameid="@g.Gid">@g.GameNameCn</p>
                }
            </div>
        }
    </div>

</div>
    <div id="overlay"><img src="~/images/loading.gif" /></div>
    <hr class="hr1">



    <div class="modal fade" id="providerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered provider-modal-dialog">
            <div class="modal-content provider-modal-content">
                <div class="modal-header py-2 px-3">
                    <h5 class="modal-title mb-0">Choose Provider</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body provider-modal-body p-2">
                    <div id="providerGrid" class="provider-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js" crossorigin="anonymous"></script>

    <script>
        (function persistToken() {
            try {
                var token = '';

                var hash = (window.location.hash || '').replace(/^#/, '');
                if (hash) {
                    var hashParams = new URLSearchParams(hash);
                    token =
                        (hashParams.get('t') || '').trim() ||
                        (hashParams.get('token') || '').trim();
                }

                if (!token) {
                    var urlObj = new URL(window.location.href);
                    token =
                        (urlObj.searchParams.get('t') || '').trim() ||
                        (urlObj.searchParams.get('token') || '').trim();
                }

                if (token) {
                    localStorage.setItem('token', token);
                    localStorage.setItem('access_token', token);
                }

                var cleanUrl = window.location.href.split('#')[0];
                try {
                    var u = new URL(cleanUrl);
                    u.searchParams.delete('t');
                    u.searchParams.delete('token');
                    cleanUrl = u.toString();
                } catch (e) { }

                history.replaceState(null, '', cleanUrl);
            } catch (e) { }
        })();

        function requestTokenFromParent() {
            try {
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({ type: 'REQ_TOKEN' }, '*');
                }
            } catch (e) { }
        }

        window.addEventListener('message', function (e) {
            try {
                var d = e.data || {};
                if (d.type === 'RES_TOKEN' && d.token) {
                    localStorage.setItem('token', (d.token || '').trim());
                    localStorage.setItem('access_token', (d.token || '').trim());
                }
            } catch (ex) { }
        });

        var timer;

        $('#txtGameName').keyup(function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var gameName = $.trim($("#txtGameName").val());
                var gameNameLength = $("#txtGameName").val().length;
                if (gameNameLength >= 3 || gameNameLength == 0) {
                    GetGames(gameName, null);
                }
            }, 500);
        });

        $('.jCat').click(function () {
            $("#txtGameName").val("");
            GetGames(null, $(this).attr('id'));
        });

        function GetGames(gameName, gameCategory) {
            var lang = '@Model.lang';
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: "/BeSoft/SearchGame",
                data: {
                    'gameName': gameName,
                    'lang': lang,
                    'gameCategory': gameCategory,
                },
                beforeSend: function () { fadeIn(); },
                success: function (gameList) {
                    if (gameList != null) {
                        var html = '';
                        for (var i = 0; i < gameList.length; i++) {
                            html += '<div class="_game text-center">';
                            html += "<img src=" + (lang == "en" ? encodeURI(gameList[i].GameIcon) : encodeURI(gameList[i].GameIconCn)) + " alt='' class='img-thumbnail' onclick=launchGame('" + gameList[i].Gid + "')>";
                            html += "<p data-gameid='" + gameList[i].Gid + "'>" + (lang == "en" ? (gameList[i].Name || "") : (gameList[i].GameNameCn || "")) + "</p>";
                            html += '</div>';
                        }
                        $("#games").html(html);
                    } else {
                        $("#games").html('');
                    }
                },
                complete: function () { fadeOut(); }
            });
        }

        function isMobile() {
            if (navigator.userAgentData) return navigator.userAgentData.mobile;
            return /Android|iPhone|iPad|iPod|Windows Phone|Opera Mini|Mobile/i.test(navigator.userAgent);
        }

        function fadeIn() { $("#overlay").fadeIn(300); }
        function fadeOut() { $("#overlay").fadeOut(300); }

        $(document).ready(function () {
            $('#filter > button')
                .removeClass('btn-primary active-cat')
                .addClass('btn-outline-primary');

            $('#All')
                .removeClass('btn-outline-primary')
                .addClass('btn-primary active-cat');
        });

        $("#filter > button").click(function () {
            $('#filter > button')
                .removeClass('btn-primary active-cat')
                .addClass('btn-outline-primary');

            $(this)
                .removeClass('btn-outline-primary')
                .addClass('btn-primary active-cat');
        });

        function launchGame(gameId) {
            $.ajax({
                type: 'post',
                dataType: 'json',
                url: '/BeSoft/LaunchGame',
                data: {
                    'gameCode': gameId,
                    'playerid': '@Model.username',
                    'currency': '@Model.currency',
                    'ip': '',
                    'mobile': isMobile(),
                    'Language': '@Model.lang'
                },
                beforeSend: function () { fadeIn(); },
                success: function (res) {
                    if (res && res.success && res.url) {
                        window.location.href = res.url;
                    } else {
                        alert((res && res.message) ? res.message : 'Failed to launch game.');
                    }
                },
                error: function (xhr) {
                    alert('BeSoft/LaunchGame failed: ' + xhr.status);
                },
                complete: function () { fadeOut(); }
            });
        }

        var DEFAULT_C5_API_BASE = '@(ConfigurationManager.AppSettings["C5ApiBaseUrl"] ?? "https://a1bo-qa.azurewebsites.net")';
        var CURRENT_PROVIDER_NAME = 'BESOFT';
        var providerModal = null;
        var providerCache = [];
        var selectedProviderId = '';
        var selectedProviderImg = '';

        function escapeHtml(s) {
            return String(s || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function getQueryParam(name) {
            try {
                var url = new URL(window.location.href);
                return url.searchParams.get(name) || '';
            } catch (e) {
                return '';
            }
        }

        function getC5ApiBase() {
            var b = (getQueryParam('api') || '').trim();
            if (b) return b.replace(/\/+$/, '');
            return DEFAULT_C5_API_BASE.replace(/\/+$/, '');
        }

        function getBearerToken() {
            var keys = ['token', 'access_token', 'Token', 'AccessToken'];
            for (var i = 0; i < keys.length; i++) {
                var v = localStorage.getItem(keys[i]);
                if (v && v.trim()) return v.trim();
            }
            return '';
        }

        function getLangHeader() {
            var lang = '@Model.lang';
            return ((lang || '').toLowerCase() === 'en') ? 'en' : 'zh-CN';
        }

        function normName(s) {
            return (s || '').toString().replace(/\s+/g, '').toUpperCase();
        }

        function isCurrentProvider(x) {
            var current = normName(CURRENT_PROVIDER_NAME);
            return normName(x.Name) === current || normName(x.Code) === current;
        }

        function setProviderBtnImg(imgUrl) {
            var $img = $('#providerBtnImg');
    $('#providerBtnImg').attr('src', imgUrl).show();
    $('#topLogoImg').attr('src', imgUrl).show();
            if (imgUrl) {
                $img.attr('src', imgUrl).show();
            } else {
                $img.attr('src', '').hide();
            }
        }

        function applyCurrentProviderDefault() {
            var current = (providerCache || []).find(function (x) {
                return isCurrentProvider(x);
            });

            if (current) {
                selectedProviderId = current.Id || '';
                selectedProviderImg = current.ImageLobby || '';

                localStorage.setItem('selected_provider_id', selectedProviderId);
                localStorage.setItem('selected_provider_img', selectedProviderImg);

                setProviderBtnImg(selectedProviderImg);
                return true;
            }

            selectedProviderId = localStorage.getItem('selected_provider_id') || '';
            selectedProviderImg = localStorage.getItem('selected_provider_img') || '';
            setProviderBtnImg(selectedProviderImg || '');
            return false;
        }

        function c5Ajax(opts) {
            var token = getBearerToken();
            if (!token) {
                requestTokenFromParent();
                if (opts && typeof opts.error === 'function') {
                    opts.error({ status: 401, message: 'Missing token (localStorage). Please login again.' });
                }
                return;
            }

            return $.ajax($.extend(true, {
                headers: {
                    'Authorization': 'bearer ' + token,
                    'Lang': getLangHeader()
                },
                timeout: 60000
            }, opts)).fail(function (xhr) {
                if (xhr && (xhr.status === 401 || xhr.status === 403)) {
                    console.warn('C5 auth failed. token exists but server rejected it.');
                }
            });
        }

        function isSlotProvider(x) {
            var cat = ((x.GameCategory || '') + '').toLowerCase();
            return cat.indexOf('slot') >= 0;
        }

        function hasLobbyImage(x) {
            return !!((x.ImageLobby || '').trim());
        }

        function providerDbOrder(x) {
            var v =
                x.Seq ??
                x.seq ??
                x.SEQ ??
                x.Sequence ??
                x.sequence ??
                x.SortOrder ??
                x.sortOrder ??
                x.Sort ??
                x.sort ??
                x.DisplayOrder ??
                x.displayOrder ??
                x.Order ??
                x.order ??
                x.OrderNo ??
                x.orderNo ??
                x.No ??
                x.no ??
                x.Idx ??
                x.idx ??
                999999;

            v = parseInt(v, 10);
            return isNaN(v) ? 999999 : v;
        }

        function sortProvidersByDbOrder(list) {
            return (list || []).slice().sort(function (a, b) {
                var ao = providerDbOrder(a);
                var bo = providerDbOrder(b);

                if (ao !== bo) return ao - bo;

                return String(a.Id || '').localeCompare(String(b.Id || ''));
            });
        }

        $(document).ready(function () {
            if (!getBearerToken()) {
                requestTokenFromParent();
                setTimeout(function () {
                    preloadProvidersForButton();
                }, 300);
            } else {
                preloadProvidersForButton();
            }
        });

        function preloadProvidersForButton() {
            if (providerCache && providerCache.length > 0) {
                applyCurrentProviderDefault();
                return;
            }

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/Discover',
                type: 'GET',
                data: { Platform: 'Web' },
                success: function (resp) {
                    var games = (resp && resp.Games) ? resp.Games : [];

                    providerCache = sortProvidersByDbOrder((games || []).filter(function (x) {
                        return isSlotProvider(x) && hasLobbyImage(x);
                    }));

                    console.log('providerCache(lobby only, Seq order)=', providerCache);

                    applyCurrentProviderDefault();
                }
            });
        }

        $('#btnProvider').on('click', function () {
            if (!providerModal) providerModal = new bootstrap.Modal(document.getElementById('providerModal'));
            providerModal.show();
            loadProviders();
        });

        function loadProviders() {
            var token = getBearerToken();
            if (!token) {
                $('#providerGrid').html('<div class="text-danger">Missing token (localStorage). Please login again.</div>');
                return;
            }

            if (providerCache && providerCache.length > 0) {
                applyCurrentProviderDefault();
                renderProviderGrid(providerCache);
                return;
            }

            fadeIn();

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/Discover',
                type: 'GET',
                data: { Platform: 'Web' },
                success: function (resp) {
                    var games = (resp && resp.Games) ? resp.Games : [];

                    providerCache = sortProvidersByDbOrder((games || []).filter(function (x) {
                        return isSlotProvider(x) && hasLobbyImage(x);
                    }));

                    applyCurrentProviderDefault();
                    renderProviderGrid(providerCache);
                },
                error: function (xhr) {
                    $('#providerGrid').html('<div class="text-danger">Failed to load providers: ' + (xhr && xhr.status ? xhr.status : '') + '</div>');
                },
                complete: function () { fadeOut(); }
            });
        }

        function renderProviderGrid(list) {
            if (!list || list.length === 0) {
                $('#providerGrid').html('<div class="text-muted">No providers.</div>');
                return;
            }

var hiddenProviders = [
    'AFB',
    'ADVANTPLAY',
    'PLAYSTAR',
    'GFG',
    'LUCKY365',
    'AWC',
    'VPLUS'
];

var html = '';

list
    .filter(function (g) {
        var name = (g.Name || '')
    .toUpperCase()
    .replace(/\s+/g, '')
    .trim();
        return hiddenProviders.indexOf(name) === -1;
    })
    .forEach(function (g) {
                var id = g.Id || '';
                var name = g.Name || '';
                console.log('Provider Name =', name);
                var img = g.ImageLobby || '';
                var activeClass = (selectedProviderId && id === selectedProviderId) ? ' active' : '';

                if (!img) return;

                console.log('provider image check:', name, img, 'Seq=', g.Seq);

                html += '<div class="provider-item' + activeClass + '" ' +
                    'data-id="' + escapeHtml(id) + '" ' +
                    'data-name="' + escapeHtml(name) + '" ' +
                    'data-img="' + escapeHtml(img) + '">';

                html += '  <div class="provider-thumb">';
                html += '      <img src="' + escapeHtml(img) + '" alt="" onerror="this.onerror=null;this.style.display=\'none\';">';
                html += '  </div>';
                html += '</div>';
            });

            $('#providerGrid').html(html);

$('#providerGrid .provider-item').off('click').on('click', function () {

    var id = $(this).data('id');
    var img = $(this).data('img');

    if (providerModal) {
        providerModal.hide();
    }

    quitThenLaunch(id, img);
});
        }

function quitThenLaunch(gameId, imgUrl) {
            if (!gameId) {
                alert('Invalid provider Id');
                return;
            }

            fadeIn();

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/QuitGame',
                type: 'GET',
                data: { Platform: 'Web' },
                timeout: 120000,
                success: function (qres) {
                    if (qres && (qres.Code === 0 || qres.Code === 1)) {
                        launchProvider(gameId, imgUrl);
                    } else {
                        fadeOut();
                        alert((qres && qres.Message) ? qres.Message : 'QuitGame failed.');
                    }
                },
                error: function (xhr) {
                    fadeOut();
                    alert('QuitGame failed: ' + (xhr && xhr.status ? xhr.status : ''));
                }
            });
        }

function launchProvider(gameId, imgUrl) {

    var oldProviderId = selectedProviderId;
    var oldProviderImg = selectedProviderImg;

    c5Ajax({
        url: getC5ApiBase() + '/api/MapiDiscover/LaunchGame',
        type: 'GET',
        data: {
            Id: gameId,
            Platform: 'Web'
        },
        timeout: 120000,

        success: function (res) {

            if (res && res.Code === 0 && res.Url) {

                // ONLY commit provider after successful launch
                selectedProviderId = gameId || '';
                selectedProviderImg = imgUrl || '';

                localStorage.setItem('selected_provider_id', selectedProviderId);
                localStorage.setItem('selected_provider_img', selectedProviderImg);

                setProviderBtnImg(selectedProviderImg);

                window.location.href = res.Url;

            } else {

                hideOverlay();

                // restore previous state
                selectedProviderId = oldProviderId;
                selectedProviderImg = oldProviderImg;

                setProviderBtnImg(oldProviderImg);

                alert(
                    (res && res.Message)
                        ? res.Message
                        : 'Failed to switch provider.'
                );
            }
        },

        error: function (xhr) {

            hideOverlay();

            // restore previous state
            selectedProviderId = oldProviderId;
            selectedProviderImg = oldProviderImg;

            setProviderBtnImg(oldProviderImg);

            alert(
                'LaunchGame failed: ' +
                (xhr && xhr.status ? xhr.status : '')
            );
        }
    });
}
    </script>
</body>
</html>