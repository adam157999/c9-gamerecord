@{
    Layout = null;
}
@model PlayStar.GetGameListRes
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Games</title>
    <!-- <link rel="stylesheet" href="./style.css"> -->
    <link rel="icon" href="./favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Scripts/LobbyCss.css" />
</head>

<body>
    <div class="container-fluid">
        <div class="row d-flex justify-content-center">
            <!-- <div id="search" class="input-group w-75 mb-3 mt-3">
            <button class="btn btn-outline-secondary" type="button">
                <i class="fa fa-search"></i>
            </button>
            <input type="text" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
        </div> -->
            <div class="inner-addon left-addon w-75 mb-3 mt-3">
                <i class="fa fa-search"></i>
                <input type="text" id="txtGameName" class="form-control" placeholder="Search Game Name" aria-label="search-game-name">
            </div>
        </div>

        <hr>
        <div id="games" class="row">
            @if (Model.ListGames != null && Model.ListGames.Count > 0)
            {
                foreach (var row in Model.ListGames)
                {
                    <div class="col-4 text-center">
                        @*<img src="@(String.Format(row.Image2)+ "?" + DateTime.Now.ToString("yyyyMMddHHmmss"))" alt="" class="img-thumbnail" 
                             onclick="launchGame('@row.game_id')">*@
                        <p class ="game-logo" data-gameid="@row.game_id">@row.game_name</p>
                    </div>
                    @*<button class="c-slot game-logo" data-gameid="@row.gameID"><img src="@(String.Format(Model.imgUrl, row.gameID)+ "?" + DateTime.Now.ToString("yyyyMMddHHmmss"))" /></button>*@
                }
            }
        </div>
        <div id="overlay">
            <div class="cv-spinner">
                <span class="spinner"></span>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js"
            integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU=" crossorigin="anonymous"></script>

    <script>
        var timer;
        var gameCategory ="";
        $('#txtGameName').keyup(function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var gameName = $.trim($("#txtGameName").val());
                var gameNameLength = $("#txtGameName").val().length;
                if (gameNameLength >= 3 || gameNameLength == 0) {
                    GetGames(gameName, gameCategory)
                }
            }, 500)
        });

        String.format = function () {
            var s = arguments[0];
            for (var i = 0; i < arguments.length - 1; i++) {
                var reg = new RegExp("\\{" + i + "\\}", "gm");
                s = s.replace(reg, arguments[i + 1]);
            }
            return s;
        }

        function GetGames(gameName, gameCategory) {
            var htmlList = "";
            var SetData = $("#games");
            var preSetHtml = "<div id='games' class='row'>"
            fadeIn()
            $.ajax({
                type: "POST",
                url: "/PlayStar/SearchGame",
                data: "{gameName:'" + gameName + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (games) {
                    if (games.ListGames != null) {
                        for (var index = 0; index < games.ListGames.length; index++) {
                            var fullPath = String.format(games.ListGames[index].Image2)
                            var fullImgUrl = fullPath + "?" + @DateTime.Now.ToString("yyyyMMddHHmmss");
                            var Data = "<div class='col-4 text-center'>" +
                                "<img src=" + fullImgUrl + " alt=''class='img-thumbnail' onclick=launchGame(" + "'" + games.ListGames[index].game_name + "'" +")>" +
                                "<p data-gameid=" + games.ListGames[index].game_id + ">" + games.ListGames[index].game_name + "</p>" +
                                "</div>";
                            htmlList = Data + htmlList
                        }
                        SetData.replaceWith(preSetHtml + htmlList)
                    }
                    fadeOut();
                }
            });
        }

        function fadeIn() {
            $("#overlay").fadeIn(300);
        };


        function fadeOut() {
            $("#overlay").fadeOut(300);
        };

        $(document).ready(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');
        });

        $("#filter > button").click(function () {
            $('#filter > button').removeClass('btn-primary');
            $('#filter > button').addClass('btn-outline-primary');

            $(this).removeClass('btn-outline-primary');
            $(this).addClass('btn-primary');
        });

        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        };

        function launchGame(gameId) {
            fadeIn()
            $.ajax({
                type: "GET",
                dataType: "json",
                url: '@Url.Action("LaunchDirectGame", "PlayStar")',
                data: {
                    "username": getUrlParameter('username'),
                    "gameid": gameId,
                    "langid": getUrlParameter('langid'),
                },
                success: function (res) {
                    var data = JSON.parse(res.Data);
                    if (data && data.ErrorCode == 0) {
                        //var userAgent = navigator.userAgent || navigator.vendor || window.opera;
                        //// iOS detection from: http://stackoverflow.com/a/9039885/177710
                        //if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
                        //    console.log("I am apple")
                        //    window.location.replace(data.url);
                        //}
                        //else {
                        //    console.log("I am android")
                        //    window.location.href = data.url;
                        //}
                        //setTimeout(() => {
                        //    window.open(data.url,"_blank");
                        //}, 500);
                        window.location.href = data.url;
                    }
                    fadeOut();
                }
            });
        };
    </script>
</body>

</html>