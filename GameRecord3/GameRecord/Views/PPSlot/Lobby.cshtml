@using System.Configuration
@{
    Layout = null;
}
@model GameRecord.Models.ProviderLobbyVM

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>PPSlot</title>
    <link rel="icon" href="./favicon.ico" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Scripts/LobbyCss.css" />

    <style>
        .top-logo-box {
            width: 240px;
            height: 90px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .top-logo-box img {
                max-width: 180px;
                max-height: 60px;
                object-fit: contain;
            }

        .container-fluid {
            padding-left: 18px;
            padding-right: 18px;
        }

        .inner-addon {
            position: relative;
        }

            .inner-addon.left-addon > i.fa-search,
            .inner-addon.left-addon > i.fa.fa-search {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                pointer-events: none;
                z-index: 2;
            }

            .inner-addon.left-addon > input.form-control {
                padding-left: 50px !important;
            }

        .lobby-top-row {
            margin-left: 0;
            margin-right: 0;
        }

            .lobby-top-row > .col-6:first-child {
                padding-left: 0;
                padding-right: 6px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 6px;
                padding-right: 0;
            }

        #txtGameName {
            height: 44px;
            border-radius: 10px;
            padding-top: 0;
            padding-bottom: 0;
            line-height: 44px;
        }

            #txtGameName::placeholder {
                line-height: normal;
            }

        .provider-btn {
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #fff;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 0 10px;
            overflow: hidden;
        }

            .provider-btn .provider-btn-img-wrap {
                flex: 1;
                height: 100%;
                min-width: 0;
                display: flex !important;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

            .provider-btn .provider-img {
                width: auto;
                height: auto;
                max-width: 70%;
                max-height: 70%;
                object-fit: contain;
                border-radius: 0;
                border: 0;
                background: transparent;
                display: block;
            }

            .provider-btn i {
                flex: 0 0 auto;
            }

        #filter {
            width: 100%;
            margin: 0;
            margin-top: -1px;
            border: 0;
            background: #fff;
            overflow: hidden;
            padding: 0;
        }

            #filter.btns {
                display: flex !important;
                justify-content: space-evenly;
                align-items: center;
                border-bottom: 1px solid #e5e5e5;
            }

            #filter .custom {
                width: 72px;
                margin: 0;
                height: 42px;
                border: 0 !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                background: transparent !important;
                color: #222 !important;
                font-size: 14px;
                font-weight: 600;
                position: relative;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

                #filter .custom.btn-primary,
                #filter .custom.active-cat {
                    background: transparent !important;
                    color: #6fc9bf !important;
                }

                    #filter .custom.btn-primary::after,
                    #filter .custom.active-cat::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        right: 0;
                        bottom: -1px;
                        height: 2px;
                        background: #6fc9bf;
                    }

        .hr1 {
            margin-top: 0;
            margin-bottom: 10px;
        }

        #games {
            padding-left: 18px;
            padding-right: 18px;
        }

            #games.row {
                margin-left: 0;
                margin-right: 0;
            }

        .provider-modal-dialog {
            width: calc(100% - 28px);
            max-width: 380px;
            margin-left: auto;
            margin-right: auto;
            margin-top: 118px;
            margin-bottom: 16px;
        }

        .modal-dialog-centered.provider-modal-dialog {
            min-height: unset;
            display: block;
            align-items: unset;
        }

        .provider-modal-content {
            border-radius: 8px;
            overflow: hidden;
            border: 0;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
        }

            .provider-modal-content .modal-header {
                height: 48px;
                padding: 0 14px !important;
                border-bottom: 1px solid #e3e3e3;
            }

            .provider-modal-content .modal-title {
                font-size: 13px;
                font-weight: 700;
                line-height: 1;
            }

            .provider-modal-content .btn-close {
                width: 14px;
                height: 14px;
                padding: 0;
                box-shadow: none;
            }

        .provider-modal-body {
            max-height: 412px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 12px 12px 12px !important;
        }

            .provider-modal-body::-webkit-scrollbar {
                width: 4px;
            }

            .provider-modal-body::-webkit-scrollbar-track {
                background: transparent;
            }

            .provider-modal-body::-webkit-scrollbar-thumb {
                background: rgba(0, 0, 0, .35);
                border-radius: 10px;
            }

        .provider-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        @@media (min-width: 768px) {
            .provider-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }
        }

        .provider-item {
            cursor: pointer;
            user-select: none;
            width: 100%;
        }

        .provider-thumb {
            width: 100%;
            height: 60px;
            border-radius: 8px;
            border: 1px solid #e6e6e6;
            background: #fff;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px 6px;
        }

            .provider-thumb img {
                max-width: 100%;
                max-height: 100%;
                width: auto;
                height: auto;
                object-fit: contain;
                display: block;
            }

        .provider-item.active .provider-thumb {
            outline: 2px solid #7ad9cf;
            background: #ecfcfa;
        }

        @@media (max-width: 575.98px) {
            .container-fluid {
                padding-left: 16px;
                padding-right: 16px;
            }

            #games {
                padding-left: 16px;
                padding-right: 16px;
            }

            .lobby-top-row > .col-6:first-child {
                padding-right: 5px;
            }

            .lobby-top-row > .col-6:last-child {
                padding-left: 5px;
            }

            .provider-modal-dialog {
                width: calc(100% - 24px);
                max-width: 372px;
                margin-top: 112px;
            }

            .provider-modal-body {
                max-height: 404px;
                padding: 10px 10px 12px 10px !important;
            }

            .provider-grid {
                gap: 8px;
            }

            .provider-thumb {
                height: 60px;
            }
        }

        @@media (max-width: 390px) {
            .container-fluid {
                padding-left: 14px;
                padding-right: 14px;
            }

            #games {
                padding-left: 14px;
                padding-right: 14px;
            }

            .provider-modal-dialog {
                width: calc(100% - 20px);
                margin-top: 108px;
            }

            .provider-modal-body {
                max-height: 396px;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .provider-thumb {
                height: 50px;
            }
        }

        @@media (max-width: 420px) {

            #txtGameName {
                font-size: 13px;
            }

                #txtGameName::placeholder {
                    font-size: 13px;
                }

            .inner-addon.left-addon > input.form-control {
                padding-left: 50px !important;
            }

            .inner-addon.left-addon > i.fa-search,
            .inner-addon.left-addon > i.fa.fa-search {
                left: 12px;
            }

            #filter .custom {
                width: 64px;
                font-size: 11px;
                letter-spacing: -0.2px;
            }
        }

        .game-section-box {
            border: 1px solid #e5e5e5;
            border-radius: 18px;
            background: #fff;
            margin-top: 12px;
            overflow: hidden;
            padding-bottom: 16px;
        }

        #overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.45);
            z-index: 9999;
            display: none;
            justify-content: center;
            align-items: center;
        }
    </style>

    <script>
        (function () {
            try {
                if (/[?&]game=[A-Za-z0-9_\-]{1,50}(&|$)/.test(location.search))
                    document.documentElement.className += ' autolaunch';
            } catch (e) { }
        })();
    </script>
    <style>
        html.autolaunch body .container-fluid {
            visibility: hidden;
        }

        html.autolaunch #overlay {
            visibility: visible;
            display: flex !important;
            background: #fff; /* plain white page with the loading gif */
        }
    </style>
</head>

<body class="ppslot">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 text-center mt-3 mb-2">
                <span class="top-logo-box">
                    <img id="topLogoImg"
                            class="provider-img"
                            src=""
                            alt=""
                            style="display:none;">
                </span>
            </div>
        </div>

        <div class="row d-flex justify-content-center lobby-top-row">
            <div class="col-6">
                <div class="inner-addon left-addon mb-3 mt-3">
                    <i class="fa fa-search"></i>
                    <input type="text" id="txtGameName" class="form-control" placeholder="Search" aria-label="search-game-name">
                </div>
            </div>

            <div class="col-6">
                <button type="button" class="provider-btn w-100 mb-3 mt-3" id="btnProvider" aria-label="select-provider">
                    <span class="provider-btn-img-wrap">
                        <img id="providerBtnImg" class="provider-img" src="" alt="" style="display:none;">
                    </span>
                    <i class="fa fa-angle-right"></i>
                </button>
            </div>
        </div>
        <div class="game-section-box">
            <div class="row d-flex justify-content-center">
                <div id="filter" class="d-flex justify-content-center btns">
                    <button class="btn-outline-primary custom" type="button" id="All">All</button>
                    <button class="btn-outline-primary custom" type="button" id="Hot">Hot</button>
                    <button class="btn-outline-primary custom" type="button" id="New">New</button>
                    <button class="btn-outline-primary custom" type="button" id="BonusBuy">Bonus Buy</button>
                </div>
            </div>
            <div id="games" class="row">
                @if (Model.gameList != null && Model.gameList.Count > 0)
                {
                    foreach (var row in Model.gameList)
                    {
                        <div class="_game text-center">
                            <img src="@(String.Format(row.ImageEn, row.GameCode) + "?" + DateTime.Now.ToString("yyyyMMddHHmmss"))"
                                 alt=""
                                 class="img-thumbnail"
                                 onclick="launchGame('@row.GameCode')">
                            <p data-gameid="@row.GameCode">@row.GameNameEn</p>
                        </div>
                    }
                }
            </div>
        </div>
    <div id="overlay"><img src="~/images/loading.gif" /></div>
    <hr class="hr1">

    <div class="modal fade" id="providerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered provider-modal-dialog">
            <div class="modal-content provider-modal-content">
                <div class="modal-header py-2 px-3">
                    <h5 class="modal-title mb-0">Choose Provider</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body provider-modal-body p-2">
                    <div id="providerGrid" class="provider-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
            crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.6.3.min.js"
            integrity="sha256-pvPw+upLPUjgMXY0G+8O0xUf+/Im1MZjXxxgOcBQBXU="
            crossorigin="anonymous"></script>

    <script>
        (function persistToken() {
            try {
                var gameToken = '';
                try {
                    var urlObj = new URL(window.location.href);
                    gameToken =
                        (urlObj.searchParams.get('t') || '').trim() ||
                        (urlObj.searchParams.get('token') || '').trim();
                } catch (e) { }

                if (gameToken) {
                    localStorage.setItem('game_token', gameToken);
                }

                var c5Token = '';
                var hash = (window.location.hash || '').replace(/^#/, '');
                if (hash) {
                    var hashParams = new URLSearchParams(hash);
                    c5Token =
                        (hashParams.get('t') || '').trim() ||
                        (hashParams.get('token') || '').trim();
                }

                // Fall back to the query-string token for the C5 bearer only
                // if no separate hash token was supplied.
                if (!c5Token) {
                    c5Token = gameToken;
                }

                if (c5Token) {
                    localStorage.setItem('token', c5Token);
                    localStorage.setItem('access_token', c5Token);
                }

                if (window.location.hash) {
                    var cleanUrl = window.location.href.split('#')[0];
                    history.replaceState(null, '', cleanUrl);
                }
            } catch (e) { }
        })();

        function requestTokenFromParent() {
            try {
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({ type: 'REQ_TOKEN' }, '*');
                }
            } catch (e) { }
        }

        window.addEventListener('message', function (e) {
            try {
                var d = e.data || {};
                if (d.type === 'RES_TOKEN' && d.token) {
                    localStorage.setItem('token', (d.token || '').trim());
                    localStorage.setItem('access_token', (d.token || '').trim());
                }
            } catch (ex) { }
        });

        var timer;
        var gameCategory = "";

        $('#txtGameName').keyup(function () {
            clearTimeout(timer);
            timer = setTimeout(function () {
                var gameName = $.trim($("#txtGameName").val());
                var gameNameLength = $("#txtGameName").val().length;
                if (gameNameLength >= 3 || gameNameLength == 0) {
                    GetGames(gameName, gameCategory);
                }
            }, 500);
        });

        $('#All').click(function () {
            gameCategory = $('#All').attr('id');
            $("#txtGameName").val("");
            GetGames("", $('#All').attr('id'));
        });

        $('#Hot').click(function () {
            gameCategory = $('#Hot').attr('id');
            $("#txtGameName").val("");
            GetGames("", $('#Hot').attr('id'));
        });

        $('#New').click(function () {
            gameCategory = $('#New').attr('id');
            $("#txtGameName").val("");
            GetGames("", $('#New').attr('id'));
        });

        $('#BonusBuy').click(function () {
            gameCategory = $('#BonusBuy').attr('id');
            $("#txtGameName").val("");
            GetGames("", $('#BonusBuy').attr('id'));
        });

        String.format = function () {
            var s = arguments[0];
            for (var i = 0; i < arguments.length - 1; i++) {
                var reg = new RegExp("\\{" + i + "\\}", "gm");
                s = s.replace(reg, arguments[i + 1]);
            }
            return s;
        }

        function GetGames(gameName, gameCategory) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("SearchGame", "PPSlot")',
                data: JSON.stringify({
                    gameName: gameName,
                    lang: "EN",
                    gameCategory: gameCategory
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                beforeSend: function () {
                    fadeIn();
                },
                success: function (games) {
                    console.log("aa" + games);
                    console.log("bb" + games[0].GameCode);

                    var htmlList = "";

                    if (games && games.length > 0) {
                        for (var index = 0; index < games.length; index++) {
                            var game = games[index];

                            var fullPath = String.format(game.ImageEn, game.GameCode);
                            var fullImgUrl = fullPath + "?" + new Date().getTime();

                            htmlList +=
                                "<div class='_game text-center'>" +
                                "<img src='" + fullImgUrl + "' alt='' class='img-thumbnail' onclick=\"launchGame('" + game.GameCode + "')\">" +
                                "<p data-gameid='" + game.GameCode + "'>" + game.GameNameEn + "</p>" +
                                "</div>";
                        }
                    }

                    $("#games").html(htmlList);
                },
                error: function (xhr) {
                    console.log("SearchGame error:", xhr.status, xhr.responseText);
                },
                complete: function () {
                    fadeOut();
                }
            });
        }

        function fadeOut() {
            $("#overlay").fadeOut(300);
        }

        function fadeIn() {
            $("#overlay").fadeIn(300);
        }

        $(document).ready(function () {
            $('#filter > button')
                .removeClass('btn-primary active-cat')
                .addClass('btn-outline-primary');

            $('#All')
                .removeClass('btn-outline-primary')
                .addClass('btn-primary active-cat');
        });

        $("#filter > button").click(function () {
            $('#filter > button')
                .removeClass('btn-primary active-cat')
                .addClass('btn-outline-primary');

            $(this)
                .removeClass('btn-outline-primary')
                .addClass('btn-primary active-cat');
        });

        function getUrlParameter(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }

        function showLobby() {
            document.documentElement.classList.remove('autolaunch');
        }

        function launchGame(gameId) {
            $.ajax({
                type: "GET",
                dataType: "json",
                url: '@Url.Action("LaunchDirectGame", "PPSlot")',
                data: {
                    "username": getUrlParameter('username'),
                    "gameid": gameId,
                    "langid": getUrlParameter('langid'),
                    "token": getGameToken(),
                },
                beforeSend: function () {
                    fadeIn();
                },
                success: function (res) {
                    var data = JSON.parse(res.Data);
                    if (data && data.ErrorCode == 0) {
                        window.location.href = data.url;     // game opens; lobby stays hidden
                    } else {
                        showLobby();                         // couldn't open: let the player pick from the list
                    }
                },
                error: function () {
                    showLobby();
                },
                complete: function () {
                    if (!document.documentElement.classList.contains('autolaunch')) fadeOut();
                }
            });
        }

        // Free spins: lobby opened with ?game=vs20fruitsw -> open that game straight away
        $(document).ready(function () {
            var autoGame = (getUrlParameter('game') || '').trim();
            if (!autoGame || !/^[A-Za-z0-9_\-]{1,50}$/.test(autoGame)) return;
            // Remove ?game= first, so pressing Back to the lobby doesn't reopen the game in a loop
            try {
                var u = new URL(window.location.href);
                u.searchParams.delete('game');
                history.replaceState(null, '', u.toString());
            } catch (e) { }
            setTimeout(showLobby, 10000);
            launchGame(autoGame);
        });

        var DEFAULT_C5_API_BASE = '@(ConfigurationManager.AppSettings["C5ApiBaseUrl"] ?? "https://a1bo-2.azurewebsites.net")';
        var CURRENT_PROVIDER_NAME = 'PPSLOT';
        var CURRENT_PROVIDER_ALIASES = ['PPSLOT', 'PP SLOT', 'PRAGMATIC', 'PRAGMATIC PLAY'];
        var providerModal = null;
        var providerCache = [];
        var selectedProviderId = '';
        var selectedProviderImg = '';

        function escapeHtml(s) {
            return String(s || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function normName(s) {
            return (s || '').toString().replace(/\s+/g, '').toUpperCase();
        }

        function getQueryParam(name) {
            try {
                var url = new URL(window.location.href);
                return url.searchParams.get(name) || '';
            } catch (e) {
                return '';
            }
        }

        function getC5ApiBase() {
            var b = (getQueryParam('api') || '').trim();
            if (b) return b.replace(/\/+$/, '');
            return DEFAULT_C5_API_BASE.replace(/\/+$/, '');
        }

        function getBearerToken() {
            var keys = ['token', 'access_token', 'Token', 'AccessToken'];
            for (var i = 0; i < keys.length; i++) {
                var v = localStorage.getItem(keys[i]);
                if (v && v.trim()) return v.trim();
            }
            return '';
        }

        function getGameToken() {
            // Used specifically for launching PPSlot games. Kept separate
            // from getBearerToken() because the query-string token and the
            // hash-fragment token are two different credentials.
            var v = localStorage.getItem('game_token');
            if (v && v.trim()) return v.trim();
            // Fall back to the C5 bearer token in case this page was ever
            // loaded without a query-string token at all.
            return getBearerToken();
        }

        function getLangHeader() {
            var lang = (getUrlParameter('langid') || '').trim();
            return ((lang || '').toLowerCase() === 'en') ? 'en' : 'zh-CN';
        }

        function isCurrentProvider(x) {
            var n = normName(x.Name);
            var c = normName(x.Code);

            for (var i = 0; i < CURRENT_PROVIDER_ALIASES.length; i++) {
                var current = normName(CURRENT_PROVIDER_ALIASES[i]);
                if (n === current || c === current) return true;
            }

            var fallback = normName(CURRENT_PROVIDER_NAME);
            return n === fallback || c === fallback;
        }

        function setProviderBtnImg(imgUrl) {
            var $img = $('#providerBtnImg');
            $('#providerBtnImg').attr('src', imgUrl).show();
            $('#topLogoImg').attr('src', imgUrl).show();
            if (imgUrl) {
                $img.attr('src', imgUrl).show();
            } else {
                $img.attr('src', '').hide();
            }
        }

        function applyCurrentProviderDefault() {
            var current = (providerCache || []).find(function (x) {
                return isCurrentProvider(x);
            });

            if (current) {
                selectedProviderId = current.Id || '';
                selectedProviderImg = current.ImageLobby || '';

                localStorage.setItem('selected_provider_id', selectedProviderId);
                localStorage.setItem('selected_provider_img', selectedProviderImg);

                setProviderBtnImg(selectedProviderImg);
                return true;
            }

            selectedProviderId = '';
            selectedProviderImg = '';
            localStorage.removeItem('selected_provider_id');
            localStorage.removeItem('selected_provider_img');
            setProviderBtnImg(selectedProviderImg || '');
            return false;
        }

        function c5Ajax(opts) {
            var token = getBearerToken();
            if (!token) {
                requestTokenFromParent();
                if (opts && typeof opts.error === 'function') {
                    opts.error({ status: 401, message: 'Missing token (localStorage). Please login again.' });
                }
                return;
            }

            return $.ajax($.extend(true, {
                headers: {
                    'Authorization': 'bearer ' + token,
                    'Lang': getLangHeader()
                },
                timeout: 60000
            }, opts)).fail(function (xhr) {
                if (xhr && (xhr.status === 401 || xhr.status === 403)) {
                    console.warn('C5 auth failed. token exists but server rejected it.');
                }
            });
        }

        function isSlotProvider(x) {
            var cat = ((x.GameCategory || '') + '').toLowerCase();
            return cat.indexOf('slot') >= 0;
        }

        function hasLobbyImage(x) {
            return !!((x.ImageLobby || '').trim());
        }

        function providerDbOrder(x) {
            var v =
                x.Seq ??
                x.seq ??
                x.SEQ ??
                x.Sequence ??
                x.sequence ??
                x.SortOrder ??
                x.sortOrder ??
                x.Sort ??
                x.sort ??
                x.DisplayOrder ??
                x.displayOrder ??
                x.Order ??
                x.order ??
                x.OrderNo ??
                x.orderNo ??
                x.No ??
                x.no ??
                x.Idx ??
                x.idx ??
                999999;

            v = parseInt(v, 10);
            return isNaN(v) ? 999999 : v;
        }

        function sortProvidersByDbOrder(list) {
            return (list || []).slice().sort(function (a, b) {
                var ao = providerDbOrder(a);
                var bo = providerDbOrder(b);

                if (ao !== bo) return ao - bo;

                return String(a.Id || '').localeCompare(String(b.Id || ''));
            });
        }

        $(document).ready(function () {
            if (!getBearerToken()) {
                requestTokenFromParent();
                setTimeout(function () {
                    preloadProvidersForButton();
                }, 300);
            } else {
                preloadProvidersForButton();
            }
        });

        function preloadProvidersForButton() {
            if (providerCache && providerCache.length > 0) {
                applyCurrentProviderDefault();
                return;
            }

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/Discover',
                type: 'GET',
                data: { Platform: 'Web' },
                success: function (resp) {
                    var games = (resp && resp.Games) ? resp.Games : [];

                    providerCache = sortProvidersByDbOrder((games || []).filter(function (x) {
                        return isSlotProvider(x)
                            && hasLobbyImage(x)
                            && (x.Status || '').toUpperCase() !== 'M';
                    }));

                    applyCurrentProviderDefault();
                }
            });
        }

        $('#btnProvider').on('click', function () {
            if (!providerModal) providerModal = new bootstrap.Modal(document.getElementById('providerModal'));
            providerModal.show();
            loadProviders();
        });

        function loadProviders() {
            var token = getBearerToken();
            if (!token) {
                $('#providerGrid').html('<div class="text-danger">Missing token (localStorage). Please login again.</div>');
                return;
            }

            if (providerCache && providerCache.length > 0) {
                applyCurrentProviderDefault();
                renderProviderGrid(providerCache);
                return;
            }

            fadeIn();

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/Discover',
                type: 'GET',
                data: { Platform: 'Web' },
                success: function (resp) {
                    var games = (resp && resp.Games) ? resp.Games : [];

                    providerCache = sortProvidersByDbOrder((games || []).filter(function (x) {
                        return isSlotProvider(x)
                            && hasLobbyImage(x)
                            && (x.Status || '').toUpperCase() !== 'M';
                    }));

                    applyCurrentProviderDefault();
                    renderProviderGrid(providerCache);
                },
                error: function (xhr) {
                    $('#providerGrid').html('<div class="text-danger">Failed to load providers: ' + (xhr && xhr.status ? xhr.status : '') + '</div>');
                },
                complete: function () { fadeOut(); }
            });
        }

        function renderProviderGrid(list) {
            if (!list || list.length === 0) {
                $('#providerGrid').html('<div class="text-muted">No providers.</div>');
                return;
            }

            var html = '';

            list.forEach(function (g) {
                var id = g.Id || '';
                var name = g.Name || '';
                var img = g.ImageLobby || '';
                var activeClass = (selectedProviderId && id === selectedProviderId) ? ' active' : '';

                if (!img) return;

                html += '<div class="provider-item' + activeClass +
                    '" data-id="' + escapeHtml(id) +
                    '" data-name="' + escapeHtml(name) +
                    '" data-img="' + escapeHtml(img) + '">';

                html += '  <div class="provider-thumb">';
                html += '      <img src="' + escapeHtml(img) + '" alt="" onerror="this.onerror=null;this.style.display=\'none\';">';
                html += '  </div>';
                html += '</div>';
            });

            $('#providerGrid').html(html);

            $('#providerGrid .provider-item').off('click').on('click', function () {
                var id = $(this).data('id');
                var img = $(this).data('img');

                selectedProviderId = id || '';
                selectedProviderImg = img || '';

                localStorage.setItem('selected_provider_id', selectedProviderId);
                localStorage.setItem('selected_provider_img', selectedProviderImg);

                setProviderBtnImg(selectedProviderImg);

                if (providerModal) providerModal.hide();

                quitThenLaunch(selectedProviderId);
            });
        }

        function quitThenLaunch(gameId) {
            if (!gameId) {
                alert('Invalid provider Id');
                return;
            }

            fadeIn();

            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/QuitGame',
                type: 'GET',
                data: { Platform: 'Web' },
                timeout: 120000,
                success: function (qres) {
                    if (qres && (qres.Code === 0 || qres.Code === 1)) {
                        launchProvider(gameId);
                    } else {
                        fadeOut();
                        alert((qres && qres.Message) ? qres.Message : 'QuitGame failed.');
                    }
                },
                error: function (xhr) {
                    fadeOut();
                    alert('QuitGame failed: ' + (xhr && xhr.status ? xhr.status : ''));
                }
            });
        }

        function launchProvider(gameId) {
            c5Ajax({
                url: getC5ApiBase() + '/api/MapiDiscover/LaunchGame',
                type: 'GET',
                data: { Id: gameId, Platform: 'Web' },
                timeout: 120000,
                success: function (res) {
                    if (res && res.Code === 0 && res.Url) {
                        window.location.href = res.Url;
                    } else {
                        alert((res && res.Message) ? res.Message : 'Failed to switch provider.');
                        fadeOut();
                    }
                },
                error: function (xhr) {
                    alert('LaunchGame failed: ' + (xhr && xhr.status ? xhr.status : ''));
                    fadeOut();
                }
            });
        }
    </script>
</body>
</html>